<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_vendas_categoria" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="DATA_INICIO" class="java.sql.Date"/>
    <parameter name="DATA_FIM" class="java.sql.Date"/>
    <parameter name="USUARIO_EMISSOR" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT c.nome AS categoria,
               COUNT(DISTINCT v.codVenda) AS qtdVendas,
               COALESCE(SUM(iv.quantidade), 0) AS itensVendidos,
               COALESCE(SUM(iv.subtotal), 0) AS faturamento
        FROM categoria c
        INNER JOIN produto p ON p.codCategoria = c.codCategoria
        INNER JOIN itensvenda iv ON iv.codProduto = p.codProduto
        INNER JOIN venda v ON v.codVenda = iv.codVenda
        WHERE DATE(v.data) BETWEEN $P{DATA_INICIO} AND $P{DATA_FIM}
        GROUP BY c.codCategoria, c.nome
        ORDER BY faturamento DESC
        ]]>
    </queryString>

    <field name="categoria" class="java.lang.String"/>
    <field name="qtdVendas" class="java.lang.Long"/>
    <field name="itensVendidos" class="java.math.BigDecimal"/>
    <field name="faturamento" class="java.lang.Double"/>

    <variable name="TOTAL_FATURAMENTO" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{faturamento}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="62" backcolor="#2C3E50"/>
            </rectangle>
            <staticText>
                <reportElement x="15" y="10" width="525" height="22" forecolor="#FFFFFF"/>
                <textElement><font size="15" isBold="true"/></textElement>
                <text><![CDATA[ATACADÃO - 01. FATURAMENTO POR CATEGORIA E PERÍODO]]></text>
            </staticText>
            <textField>
                <reportElement x="15" y="36" width="525" height="18" forecolor="#ECF0F1"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_INICIO}) + " a " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_FIM}) + " | Emitido por: " + $P{USUARIO_EMISSOR}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText><reportElement mode="Opaque" x="0" y="0" width="235" height="25" backcolor="#2ECC71" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[  Categoria]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="235" y="0" width="90" height="25" backcolor="#2ECC71" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Vendas]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="325" y="0" width="100" height="25" backcolor="#2ECC71" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Qtd. Itens]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="425" y="0" width="130" height="25" backcolor="#2ECC71" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Faturamento (R$)  ]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField><reportElement x="0" y="0" width="235" height="22"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA["  " + $F{categoria}]]></textFieldExpression></textField>
            <textField><reportElement x="235" y="0" width="90" height="22"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{qtdVendas}]]></textFieldExpression></textField>
            <textField><reportElement x="325" y="0" width="100" height="22"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{itensVendidos}]]></textFieldExpression></textField>
            <textField pattern="R$ #,##0.00"><reportElement x="425" y="0" width="130" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{faturamento}]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="260">
            <textField>
                <reportElement mode="Opaque" x="0" y="5" width="555" height="26" backcolor="#ECF0F1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["FATURAMENTO TOTAL: R$ " + new java.text.DecimalFormat("#,##0.00").format($V{TOTAL_FATURAMENTO} != null ? $V{TOTAL_FATURAMENTO} : 0.0) + "  "]]></textFieldExpression>
            </textField>
            <pieChart>
                <chart evaluationTime="Report">
                    <reportElement x="30" y="40" width="495" height="210"/>
                    <chartTitle><titleExpression><![CDATA["Participação no Faturamento por Categoria"]]></titleExpression></chartTitle>
                    <chartSubtitle/>
                    <chartLegend/>
                </chart>
                <pieDataset>
                    <keyExpression><![CDATA[$F{categoria}]]></keyExpression>
                    <valueExpression><![CDATA[$F{faturamento}]]></valueExpression>
                </pieDataset>
                <piePlot isShowLabels="true">
                    <plot/>
                    <itemLabel/>
                </piePlot>
            </pieChart>
        </band>
    </summary>
</jasperReport>