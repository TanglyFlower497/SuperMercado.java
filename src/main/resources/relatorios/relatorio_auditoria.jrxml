<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_auditoria" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="USUARIO_EMISSOR" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT codAuditoria,
               COALESCE(tabela, '-') AS tabela,
               COALESCE(acao, '-') AS acao,
               DATE_FORMAT(dataHora, '%d/%m/%Y %H:%i:%s') AS dataHoraFormatada,
               COALESCE(usuario, '-') AS usuario
        FROM auditoria
        ORDER BY codAuditoria DESC
        ]]>
    </queryString>

    <field name="codAuditoria" class="java.lang.Integer"/>
    <field name="tabela" class="java.lang.String"/>
    <field name="acao" class="java.lang.String"/>
    <field name="dataHoraFormatada" class="java.lang.String"/>
    <field name="usuario" class="java.lang.String"/>

    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="62" backcolor="#2C3E50"/>
            </rectangle>
            <staticText>
                <reportElement x="15" y="10" width="525" height="22" forecolor="#FFFFFF"/>
                <textElement><font size="15" isBold="true"/></textElement>
                <text><![CDATA[ATACADÃO - 05. AUDITORIA DE EXCLUSÕES E OPERAÇÕES]]></text>
            </staticText>
            <textField>
                <reportElement x="15" y="36" width="525" height="18" forecolor="#ECF0F1"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Gerado em: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date()) + " | Emitido por: " + $P{USUARIO_EMISSOR}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText><reportElement mode="Opaque" x="0" y="0" width="45" height="25" backcolor="#34495E" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="45" y="0" width="80" height="25" backcolor="#34495E" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Tabela]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="125" y="0" width="215" height="25" backcolor="#34495E" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[  Ação Registrada]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="340" y="0" width="110" height="25" backcolor="#34495E" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Data / Hora]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="450" y="0" width="105" height="25" backcolor="#34495E" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Usuário Banco]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField><reportElement x="0" y="0" width="45" height="22"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{codAuditoria}]]></textFieldExpression></textField>
            <textField><reportElement x="45" y="0" width="80" height="22"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{tabela}]]></textFieldExpression></textField>
            <textField><reportElement x="125" y="0" width="215" height="22"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA["  " + $F{acao}]]></textFieldExpression></textField>
            <textField><reportElement x="340" y="0" width="110" height="22"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{dataHoraFormatada}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="0" width="105" height="22"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{usuario}]]></textFieldExpression></textField>
        </band>
    </detail>

    <summary>
        <band height="35">
            <textField>
                <reportElement mode="Opaque" x="0" y="5" width="555" height="26" backcolor="#ECF0F1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["TOTAL DE REGISTROS DE AUDITORIA: " + $V{REPORT_COUNT} + "  "]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>